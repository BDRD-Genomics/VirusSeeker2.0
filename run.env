# VirusSeeker 2.0 runtime configuration
#
# This file is normally generated by install.sh.
# Set VS_EXECUTION_MODE to either:
#   docker - use the Docker image + local sbatch shim
#   slurm  - run the Git checkout natively + use the site's real sbatch

export VS_EXECUTION_MODE="docker"

# Installation root chosen during installation.
export VS_ROOT="/export/apps/virusseeker"
export VS_INPUT_DIR="$VS_ROOT/input"
export VS_OUTPUT_DIR="$VS_ROOT/output"
export VS_CONFIG_DIR="$VS_ROOT/config"
export VS_SCRATCH_DIR="$VS_ROOT/scratch"
export VS_STATE_DIR="$VS_ROOT/state"
export VS_DATABASE_DIR="$VS_ROOT/databases"

export VS_READS_FILE="$VS_CONFIG_DIR/reads.txt"
export VS_CONFIG_FILE="$VS_CONFIG_DIR/VS.config"
export VS_CFG_FILE="$VS_CONFIG_DIR/VS.cfg"

# Auxiliary VirusSeeker databases.
export VS_VHUNTER_HOST="$VS_DATABASE_DIR/vhunter_acc.db"
export VS_NCBI_TAXADB_HOST="$VS_DATABASE_DIR/taxa.sqlite"
export VS_TAXDUMP_HOST="$VS_DATABASE_DIR/taxdump"

# Docker runtime paths. install.sh changes these to host paths in SLURM mode.
export VS_VHUNTER_RUNTIME="/database/vhunter_acc.db"
export VS_NCBI_TAXADB_RUNTIME="/database/taxa.sqlite"
export VS_TAXDUMP_RUNTIME="/database/taxdump"

# Run-specific settings.
export VS_RUN_NAME="real_run_001"
export VS_HOST_DB="X"
export VS_READ_TYPE="s"
export VS_ANALYSIS_MODE="m"
export VS_MEMORY="64G"
export VS_CPUS="30"
export VS_EXTRA_FLAGS="-v"

# Docker mode settings.
export VS_IMAGE="virusseeker2:test"
export VS_CONTAINER="virusseeker-${VS_RUN_NAME}"
export VS_CONDA_PREFIX="/opt/conda"
export VS_SLURM_PARTITION="local"

# Native SLURM settings.
# These are ignored while VS_EXECUTION_MODE=docker.
export VS_NATIVE_VS_HOME="/path/to/VirusSeeker2.0"
# For native mode install.sh writes the actual Conda prefix here.
# Example: /data/miniforge
